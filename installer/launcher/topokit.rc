#include <windows.h>
#include "resource.h"

IDI_APP ICON "topokit.ico"
IDI_ON  ICON "tray_on.ico"
IDI_OFF ICON "tray_off.ico"
IDR_LOGO      RCDATA "logo.png"

/* Licenta TopoKit: textele se pun din program (romana / engleza) */
IDD_LICENSE DIALOGEX 0, 0, 290, 156
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TopoKit"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "", IDC_LIC_INFO, 10, 10, 270, 34
    LTEXT           "", IDC_LIC_CODELBL, 10, 48, 270, 10
    EDITTEXT        IDC_LIC_CODE, 10, 60, 270, 14, ES_UPPERCASE | ES_AUTOHSCROLL
    LTEXT           "", IDC_LIC_MACHINE, 10, 84, 206, 10
    PUSHBUTTON      "", IDC_LIC_COPY, 222, 81, 58, 14
    LTEXT           "", IDC_LIC_STATUS, 10, 101, 270, 26
    PUSHBUTTON      "", IDC_LIC_IMPORT, 10, 134, 78, 15
    PUSHBUTTON      "", IDC_LIC_DEACT, 92, 134, 66, 15
    DEFPUSHBUTTON   "", IDOK, 162, 134, 58, 15
    PUSHBUTTON      "", IDCANCEL, 224, 134, 56, 15
END
IDR_ICON1     RCDATA "icons/m1.png"
IDR_ICON1 + 1 RCDATA "icons/m2.png"
IDR_ICON1 + 2 RCDATA "icons/m3.png"
IDR_ICON1 + 3 RCDATA "icons/m4.png"
IDR_ICON1 + 4 RCDATA "icons/m5.png"
IDR_ICON1 + 5 RCDATA "icons/m6.png"
IDR_ICON1 + 6 RCDATA "icons/m7.png"
IDR_ICON1 + 7 RCDATA "icons/m8.png"
IDR_ICON1 + 8 RCDATA "icons/m9.png"
IDR_ICON1 + 9 RCDATA "icons/m10.png"
IDR_ICON1 + 10 RCDATA "icons/m11.png"
IDR_ICON1 + 11 RCDATA "icons/m12.png"
IDR_ICON1 + 12 RCDATA "icons/m13.png"
IDR_ICON1 + 13 RCDATA "icons/m14.png"
IDR_ICON1 + 14 RCDATA "icons/m15.png"
IDR_ICON1 + 15 RCDATA "icons/m16.png"
IDR_ICON1 + 16 RCDATA "icons/m17.png"
IDR_ICON1 + 17 RCDATA "icons/m18.png"
IDR_ICON1 + 18 RCDATA "icons/m19.png"
IDR_ICON1 + 19 RCDATA "icons/m20.png"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "topokit.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TK_VER_COMMA
PRODUCTVERSION  TK_VER_COMMA
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041804B0"
    BEGIN
      VALUE "CompanyName",      "TopoKit"
      VALUE "FileDescription",  "TopoKit - lansator AutoCAD"
      VALUE "FileVersion",      TK_VER_STR
      VALUE "InternalName",     "TopoKit"
      VALUE "OriginalFilename", "TopoKit.exe"
      VALUE "ProductName",      "TopoKit"
      VALUE "ProductVersion",   TK_VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0418, 1200
  END
END
